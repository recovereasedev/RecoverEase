# ---------------------------------------------------------------------------
# RecoverEase environment
# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in real values. `.env*` is gitignored; only
# this example file is tracked. Never put a real key in this file.
#
# Anything prefixed VITE_ is compiled into the browser bundle and is public.
# Only ever put publishable (anon) credentials here.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable key (sb_publishable_... or the legacy anon JWT).
# Safe to expose: it carries no privileges beyond what RLS policies allow.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY - never prefix these with VITE_, never commit real values.
# These belong in Supabase Edge Function secrets
# (`supabase secrets set ...`), not in this repo and not in Vercel's
# client-visible env.
# ---------------------------------------------------------------------------
#   SUPABASE_SERVICE_ROLE_KEY   Full database access, bypasses RLS.
#                               Used only by Edge Functions that provision
#                               accounts (admin creates doctor, doctor
#                               creates patient).
#   CHATBOT_API_KEY             Credential for the AI chatbot provider used
#                               by the post-treatment guidance module.
